# Port du serveur (défaut: 4000)
PORT=4000

# Secret JWT (CHANGEZ-MOI en production!)
JWT_SECRET=invoice-mgmt-secret-key-change-in-prod

# MySQL connection string (XAMPP default: root with no password)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/invoice_management"
