generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  nom        String
  role       String   @default("user")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clients    Client[]
  invoices   Invoice[]
  signatures Signature[]
}

model Client {
  id         String   @id @default(uuid())
  nom        String
  email      String
  tel        String
  adresse    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_id    String
  public_key String?

  user     User      @relation(fields: [user_id], references: [id])
  invoices Invoice[]
}

model Category {
  id  Int    @id @default(autoincrement())
  nom String @unique
  tva Float

  articles Article[]
}

model Article {
  id            Int      @id @default(autoincrement())
  designation   String
  prix_unitaire Float
  categorie_id  Int
  category      Category @relation(fields: [categorie_id], references: [id])

  invoice_articles InvoiceArticle[]
  quote_articles   QuoteArticle[]
}

model Invoice {
  id                  String    @id @default(uuid())
  numero              String    @unique
  date_creation       DateTime  @default(now())
  total_ht            Float
  tva                 Float
  total_ttc           Float
  statut              String    @default("brouillon")
  date_depot          DateTime?
  date_encaissement   DateTime?
  type_virement       String?
  notes               String?
  user_id             String
  client_id           String
  validated_by_admin  Boolean   @default(false)
  validated_by_client Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user       User             @relation(fields: [user_id], references: [id])
  client     Client           @relation(fields: [client_id], references: [id])
  articles   InvoiceArticle[]
  signature  Signature?
  audit_logs AuditLog[]
}

model InvoiceArticle {
  id            Int    @id @default(autoincrement())
  invoice_id    String
  article_id    Int
  designation   String
  quantite      Int
  prix_unitaire Float
  remise        Float  @default(0)
  total_ligne   Float
  categorie_id  Int
  tva           Float  @default(0)

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  article Article @relation(fields: [article_id], references: [id])
}

model Quote {
  id            String   @id @default(uuid())
  numero_devis  String   @unique
  client_nom    String
  client_email  String
  client_id     String
  date_creation DateTime @default(now())
  date_validite DateTime
  statut        String   @default("envoye")
  total_ht      Float
  total_tva     Float
  total_ttc     Float
  notes         String?
  user_id       String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  articles QuoteArticle[]
}

model QuoteArticle {
  id            Int    @id @default(autoincrement())
  quote_id      String
  article_id    Int
  designation   String
  quantite      Int
  prix_unitaire Float
  categorie_nom String
  tva           Float
  total_ht      Float
  total_tva     Float

  quote   Quote   @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  article Article @relation(fields: [article_id], references: [id])
}

model Signature {
  id             String   @id @default(uuid())
  invoice_id     String   @unique
  user_id        String
  signature_data String
  signed_hash    String
  public_key     String
  algorithm      String   @default("RSA-SHA256")
  signed_at      DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  invoice_id String
  action     String
  old_statut String?
  new_statut String?
  user_id    String
  details    String?
  created_at DateTime @default(now())

  invoice Invoice @relation(fields: [invoice_id], references: [id])
}
